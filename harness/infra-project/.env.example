# S3 — креды для restic. Заполни значения между кавычками.
# Команда для заполнения: nano ~/projects/infra/.env
#
# RESTIC_PASSWORD — ключ расшифровки бэкапа. Потеря пароля = потеря бэкапа.
# Обязательно сохрани его в менеджере паролей.
# Этот файл в .gitignore — в git не попадёт.

# Адрес репозитория в S3. ФОРМАТ: s3:хост/имя_бакета (слэш, НЕ двоеточие перед бакетом!)
# Пример для beget: s3:s3.ru1.storage.beget.cloud/my-bucket
RESTIC_REPOSITORY="s3:CHANGE_ME.example.com/my-bucket"

# Пароль шифрования репозитория restic
RESTIC_PASSWORD="CHANGE_ME"

# Креды доступа к S3 (из панели провайдера)
AWS_ACCESS_KEY_ID="CHANGE_ME"
AWS_SECRET_ACCESS_KEY="CHANGE_ME"
