#!/usr/bin/env python3
"""evm - единая команда метода ЭВМ (EPIC-026 vosmenog).

  evm boot [проект] [--role solo|head|hands|text] [--brief]
      Что читать и в каком порядке (платформа -> карта сервера -> роль -> проект ->
      смена) и что сейчас горит (прошлая смена, входящее, соседи, дерево).
      Проект не назван: берётся $VOSMENOG_PROJECT, иначе по текущему каталогу.
      Роль не названа: $EVM_ROLE, иначе solo. --brief - краткая форма (возобновление).
  evm threshold
      Порог смены: соседние сессии, оркестратор, дерево, раскладка.
  evm close [проект]
      Чек-лист закрытия смены. Только читает. Код возврата 1, если есть красное.
  evm guard stop
      Сторож конца смены для хука Stop Claude Code (читает JSON со stdin).
  evm off | evm on | evm status
      Постоянный выключатель харнесса: off - хуки молчат, evm boot печатает одну строку, проверка обновлений
      и автообновление молчат, установщики не возвращают подключения; on - всё обратно. status - состояние.
  evm auto on|off|status
      Автоматическое обновление метода (по умолчанию выключено). Накатывает само только релизы,
      которые автор пометил в CHANGELOG.md строкой <!-- auto: ok -->; остальное - вручную (vosya-update).

Любому агенту с доступом к шеллу достаточно фразы:
  «Прочитай /home/<пользователь>/agent-os/BOOT.md и работай по методу в проекте <ключ>».
"""
import argparse
import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path

HOME = Path(os.path.expanduser("~"))
HERE = Path(os.path.realpath(__file__)).parent
INDEXER = HERE / "projects-index.py"
THRESHOLD = HERE / "evm-threshold"
TEAM = HOME / "projects/team-work"
STATE = HOME / ".local/state/evm"
BUDGET = 3500            # было 3000; +500 на «Первое дело» (решение владельца 11.10)
BRIEF_BUDGET = 2300      # было 1500; то же
STALE_MIN = int(os.environ.get("EVM_STALE_MIN", "30"))
MEM_MAX = 4000
JOURNAL_LINE_MAX = 200
FIRST_TASK_MAX = 600

ROLES = ("solo", "head", "hands", "text")
PERSONA = {
    "head": (HOME / ".claude/agents/minotaur.md", HOME / "agent-os/head-kit/persona_minotaurus.md"),
    "hands": (HOME / "agent-os/persona_vosya.md", HOME / ".claude/agents/vosya.md"),
    "text": (HOME / ".claude/agents/zina.md",),
}


# ---------- общие помощники ----------

def tilde(p):
    """Путь для вывода. Абсолютный, а не «~/...»: чужие агенты (проверено на Kimi,
    EPIC-026 Ф3 AC-4) не раскрывают тильду и подставляют выдуманный /home/user."""
    return str(p)


def size(p):
    try:
        return len(Path(p).read_text(encoding="utf-8", errors="replace"))
    except OSError:
        return None


def mark(p):
    n = size(p)
    return f"{tilde(p)} ({n} зн.)" if n is not None else f"{tilde(p)} - НЕТ"


def git(repo, *args):
    r = subprocess.run(["git", "-C", str(repo), *args], capture_output=True, text=True)
    return r.stdout if r.returncode == 0 else ""


def resolve(key):
    """-> (код проекта | None, каталог планирования | None, ошибка | None)."""
    if INDEXER.is_file():
        r = subprocess.run([sys.executable, str(INDEXER), "--resolve", key],
                           capture_output=True, text=True)
        if r.returncode == 0:
            code, _, plan = r.stdout.strip().partition("\t")
            return Path(code), (Path(plan) if plan else None), None
        if r.returncode == 3:
            return None, None, r.stderr.strip()
    if (TEAM / key).is_dir():       # проект без кода (например home): только планирование
        return None, TEAM / key, None
    return None, None, f"нет проекта «{key}». Реестр: {HOME}/projects/INDEX.md"


def infer_project(cwd=None):
    """Ключ проекта без аргумента: $VOSMENOG_PROJECT, затем каталог планирования
    team-work/<имя>/, затем реестр по каталогу кода. None - не удалось."""
    env = os.environ.get("VOSMENOG_PROJECT", "").strip()
    if env:
        return env
    cwd = Path(cwd or os.getcwd()).resolve()
    try:
        rel = cwd.relative_to(TEAM)
        if rel.parts:
            return rel.parts[0]
    except ValueError:
        pass
    if INDEXER.is_file():
        r = subprocess.run([sys.executable, str(INDEXER), "--which", str(cwd)],
                           capture_output=True, text=True)
        if r.returncode == 0 and r.stdout.strip():
            return r.stdout.strip()
    return None


def persona_line(role):
    if role == "solo":
        return ("solo - один агент, режимы думаю / делаю / проверяю. Переход между режимами фиксируется "
                "документом (EPIC/TASK), развилка уходит владельцу, документирует тот, кто работал; "
                f"в журнале подпись своей персоны. Подробно: {HOME}/agent-os/method/modes.md. Роль: --role head|hands|text")
    for cand in PERSONA[role]:
        if cand.is_file():
            return f"{role} - прочитай {mark(cand)}"
    return f"{role} - файл персоны не найден (искал: " + ", ".join(tilde(c) for c in PERSONA[role]) + ")"


# ---------- прошлая смена ----------

def newest_dirty_mtime(repo, subpath=None):
    """Самая свежая правка среди незакоммиченных (без неотслеживаемого мусора)."""
    args = ["status", "--porcelain"] + (["--", subpath] if subpath else [])
    out = git(repo, *args)
    newest, count = 0.0, 0
    for ln in out.splitlines():
        if ln.startswith("??"):
            continue
        count += 1
        f = Path(repo) / ln[3:].split(" -> ")[-1].strip('"')
        try:
            newest = max(newest, f.stat().st_mtime)
        except OSError:
            pass
    return newest, count


def work_state(code, plan):
    """Что изменилось в проекте. Возвращает dict: mem_path, mem_ts, last_work_ts,
    commits_code, commits_plan (после памяти), dirty."""
    mem = (plan / "sessions/next-session.md") if plan else None
    mem_ts = mem.stat().st_mtime if mem and mem.is_file() else 0.0
    last = 0.0
    commits_code = commits_plan = dirty = 0
    if code and (code / ".git").exists():
        t = git(code, "log", "-1", "--format=%ct").strip()
        if t:
            last = max(last, float(t))
        commits_code = len(git(code, "log", f"--since=@{int(mem_ts)}", "--format=%h").split()) if mem_ts else 0
        nt, n = newest_dirty_mtime(code)
        last, dirty = max(last, nt), dirty + n
    if plan and TEAM.exists() and (TEAM / ".git").exists():
        try:
            rel = str(plan.relative_to(TEAM))
        except ValueError:
            rel = None
        if rel:
            t = git(TEAM, "log", "-1", "--format=%ct", "--", rel, f":(exclude){rel}/sessions").strip()
            if t:
                last = max(last, float(t))
            if mem_ts:
                commits_plan = len(git(TEAM, "log", f"--since=@{int(mem_ts)}", "--format=%h", "--",
                                       rel, f":(exclude){rel}/sessions").split())
            # правки самой памяти и журнала работой не считаем
            out = git(TEAM, "status", "--porcelain", "--", rel, f":(exclude){rel}/sessions")
            n = len([ln for ln in out.splitlines() if not ln.startswith("??")])
            nt = 0.0
            for ln in out.splitlines():
                if ln.startswith("??"):
                    continue
                try:
                    nt = max(nt, (TEAM / ln[3:].strip('"')).stat().st_mtime)
                except OSError:
                    pass
            last, dirty = max(last, nt), dirty + n
    return {"mem": mem, "mem_ts": mem_ts, "last": last,
            "commits_code": commits_code, "commits_plan": commits_plan, "dirty": dirty}


def ago(sec):
    m = int(sec // 60)
    if m < 90:
        return f"{m} мин"
    h = m / 60
    return f"{h:.0f} ч" if h < 48 else f"{h / 24:.0f} дн"


def last_shift_line(code, plan):
    if not plan:
        return None
    w = work_state(code, plan)
    if not w["mem_ts"]:
        return "прошлая смена: горячей памяти нет (sessions/next-session.md) - заведи из шаблона"
    age = time.time() - w["mem_ts"]
    txt = w["mem"].read_text(encoding="utf-8", errors="replace")
    head = "есть" if re.search(r"HEAD самодостаточен|в дереве починка", txt) else "НЕТ"
    extra = ""
    if w["commits_code"] or w["commits_plan"] or w["dirty"]:
        extra = (f"; после неё коммитов {w['commits_code']} (код) + {w['commits_plan']} (планирование), "
                 f"незакоммиченных {w['dirty']}")
    return f"прошлая смена: память обновлена {ago(age)} назад{extra}; строка «HEAD самодостаточен»: {head}"


# ---------- первое дело ----------

def first_task_block(plan):
    """Секция «Первое дело…» горячей памяти прямо в блок: порядок чтения говорит, ЧТО читать,
    а суть смены должна быть в контексте с первой секунды (проверка ds, EPIC-026 Ф5).
    Нет секции - пишем это вслух: память без структуры, агент должен читать её целиком."""
    ns = (plan / "sessions/next-session.md") if plan else None
    if not ns or not ns.is_file():
        return []
    txt = ns.read_text(encoding="utf-8", errors="replace")
    m = re.search(r"^##\s+Первое дело[^\n]*\n(.*?)(?=^##\s|\Z)", txt, re.S | re.M)
    if not m or not m.group(1).strip():
        return ["Первое дело: секции «Первое дело…» в горячей памяти нет - она без структуры, читай файл целиком "
                f"({len(txt)} зн.) до первого ответа"]
    body = m.group(1).strip()
    cut = len(body) > FIRST_TASK_MAX
    if cut:
        body = body[:FIRST_TASK_MAX].rsplit("\n", 1)[0].rstrip()
    out = ["Первое дело (из горячей памяти" + (", обрезано - полностью в файле" if cut else "") + "):"]
    out += ["  " + ln if ln.strip() else "" for ln in body.splitlines()]
    return out


# ---------- threshold ----------

def threshold_lines(cwd, limit=None):
    if not THRESHOLD.is_file():
        return ["порог смены недоступен: нет evm-threshold рядом с evm (повтори update.sh)"]
    try:
        r = subprocess.run(["bash", str(THRESHOLD)], cwd=str(cwd) if cwd else None,
                           capture_output=True, text=True, timeout=15)
    except (subprocess.TimeoutExpired, OSError):
        return ["порог смены не ответил за 15 с"]
    lines = [ln.rstrip() for ln in r.stdout.splitlines() if ln.strip() and not ln.startswith("──")]
    return lines[:limit] if limit else lines


# ---------- обновление метода ----------

UPDATE_CHECK = HOME / ".config/opencode/memory/update-check.sh"
UPDATE_TIMEOUT = 6      # с: проверка ходит в сеть (git fetch); хук старта живёт 10 с, задержка не должна его ломать


def update_notice():
    """Блок «Обновление метода» из update-check.sh. Пусто, если нечего сказать, нет сети или нет источника.
    Обычный запуск update-check ставит отметку «показано»: уведомление об уже раскатанном придёт один раз,
    о нераскатанном - на каждом старте, пока владелец не запустит vosya-update."""
    if not UPDATE_CHECK.is_file():
        return []
    try:
        r = subprocess.run(["bash", str(UPDATE_CHECK)], capture_output=True, text=True, timeout=UPDATE_TIMEOUT)
    except (subprocess.TimeoutExpired, OSError):
        return []
    # Хеши коммитов и списки файлов агенту на старте не нужны: ему нужен пересказ по CHANGELOG.md,
    # а после долгого перерыва эти списки занимают тысячи знаков. Полный вывод - в update-check.sh.
    lines = [ln.rstrip() for ln in r.stdout.splitlines()
             if ln.strip() and not re.match(r"^\s+[0-9a-f]{7,} ", ln) and not ln.startswith("    ") and ln.strip() != "файлы:"]
    if not lines:
        return []
    return (["Обновление метода: расскажи владельцу по-человечески, по этому тексту (что нового, нужно ли что-то делать). "
             "Накатывает он сам командой vosya-update; сам update.sh без его просьбы не запускай:"]
            + ["  " + ln for ln in lines[:14]])


# ---------- boot ----------

def boot(key, role, brief):
    if harness_off():
        print("Харнесс выключен (evm on - включить). Работай как обычный агент: порядок чтения слоёв, память смены и обновления метода не требуются.")
        return 0
    if not key:
        key = infer_project()
    if not key:
        print("evm: проект не назван и не определился ($VOSMENOG_PROJECT пуст, каталог не в реестре). "
              "Укажи: evm boot <ключ>", file=sys.stderr)
        return 1
    code, plan, err = resolve(key)
    if err:
        print(f"evm: {err}", file=sys.stderr)
        return 1
    shown = plan.name if plan else (code.name if code else key)
    L = [f"== evm boot: {shown} · роль: {role}{' · кратко' if brief else ''} =="]
    ns = (plan / "sessions/next-session.md") if plan else None
    epic_line = None
    if plan and ns and ns.is_file():
        m = re.search(r"EPIC-(\d+)", ns.read_text(encoding="utf-8", errors="replace"))
        hit = sorted((plan / "epics").glob(f"EPIC-{m.group(1)}*.md")) if m else []
        if hit:
            epic_line = f"              эпик из горячей памяти: {mark(hit[0])}"
    if brief:
        L.append("Контекст уже был; читай заново только смену:")
    else:
        L.append("Читай по порядку (в скобках размер):")
        L.append(f" 1 платформа  {mark(HOME / 'agent-os/METHOD.md')} - стопы, эпик-цикл; по необходимости")
        L.append(f" 2 сервер     {mark(TEAM / 'SERVER.md')} - правила этой машины, читать")
        L.append(f" 3 роль       {persona_line(role)}")
        if code:
            proj_md = next((code / n for n in ("AGENTS.md", "CLAUDE.md") if (code / n).is_file()), code / "AGENTS.md")
            L.append(f" 4 проект     {mark(proj_md)} - карта, гейты, ветки")
        else:
            L.append(" 4 проект     кода нет, только планирование")
    if plan:
        L.append(f" 5 смена      {mark(plan / 'sessions/next-session.md')} - целиком")
        if epic_line:
            L.append(epic_line)
        L.append(f"              журнал {tilde(plan / 'sessions/journal.md')} и archive/ - только грепом, не целиком")
    else:
        L.append(" 5 смена      нет каталога планирования в team-work")
    L.extend(first_task_block(plan))
    L.append("Живое:")
    ls = last_shift_line(code, plan)
    if ls:
        L.append(" " + ls)
    if plan:
        inc = plan / "exchange/incoming"
        files = sorted((f for f in inc.glob("*") if f.is_file()), key=lambda f: f.stat().st_mtime, reverse=True) if inc.is_dir() else []
        L.append(f" входящее: {len(files)} в {tilde(inc)}" + (" - свежие: " + ", ".join(f.name for f in files[:3]) if files else ""))
    for ln in threshold_lines(code, limit=9 if brief else None):
        L.append(" " + ln.strip())
    if not brief:
        L.extend(update_notice())
    L.append("Конец смены: `evm close` (чек-лист) и STARTUP.md, «Завершение сессии».")
    text = "\n".join(L)
    print(text)
    cap = BRIEF_BUDGET if brief else BUDGET
    if len(text) > cap:
        print(f"\n(! вывод {len(text)} зн. при бюджете {cap})", file=sys.stderr)
    return 0


# ---------- close ----------

def close(key):
    key = key or infer_project()
    if not key:
        print("evm: проект не определился. Укажи: evm close <ключ>", file=sys.stderr)
        return 1
    code, plan, err = resolve(key)
    if err or not plan:
        print(f"evm: {err or 'нет каталога планирования'}", file=sys.stderr)
        return 1
    w = work_state(code, plan)
    bad = 0
    out = [f"== evm close: {plan.name} =="]

    def row(ok, text, warn=False):
        nonlocal bad
        out.append(f" {'✓' if ok else ('!' if warn else '✗')} {text}")
        if not ok and not warn:
            bad += 1

    mem = w["mem"]
    if not w["mem_ts"]:
        row(False, f"горячая память: файла нет ({tilde(mem)})")
    else:
        lag = w["last"] - w["mem_ts"]
        row(lag <= 60, "горячая память обновлена после последней работы" if lag <= 60
            else f"горячая память старше последней работы на {ago(lag)}: перезапиши {tilde(mem)}")
        n = size(mem)
        row(n <= MEM_MAX, f"горячая память {n} зн. (потолок {MEM_MAX})")
        txt = mem.read_text(encoding="utf-8", errors="replace")
        row(bool(re.search(r"HEAD самодостаточен|в дереве починка", txt)),
            "в памяти есть строка «HEAD самодостаточен» / «в дереве починка»")
    jr = plan / "sessions/journal.md"
    if jr.is_file():
        today = {time.strftime("%Y-%m-%d"), time.strftime("%Y-%m-%d", time.gmtime())}
        lines = [ln for ln in jr.read_text(encoding="utf-8", errors="replace").splitlines()
                 if any(ln.startswith(d) for d in today)]
        signed = [ln for ln in lines if re.search(r"\[[^\]]+\]", ln)]
        if not lines:
            row(False, "в журнале нет сегодняшней строки")
        elif not signed:
            row(False, "сегодняшняя строка журнала без подписи персоны ([мин] / [вос] / [зин])")
        else:
            long_ = [ln for ln in signed if len(ln) > JOURNAL_LINE_MAX]
            row(not long_, "строка журнала подписана, ≤200 знаков" if not long_
                else f"строка журнала длиннее {JOURNAL_LINE_MAX} знаков ({len(long_[-1])})")
    else:
        row(False, f"журнала нет: {tilde(jr)}")
    if w["dirty"]:
        row(False, f"незакоммиченных правок в проекте и планировании: {w['dirty']} - свои закоммить, чужие не трогай", warn=True)
    else:
        row(True, "незакоммиченных правок нет")
    if code and (code / ".git").exists():
        wt = [ln for ln in git(code, "worktree", "list", "--porcelain").splitlines() if ln.startswith("worktree ")]
        stray = [ln[9:] for ln in wt[1:] if "/.worktrees/" not in ln]
        row(not stray, "рабочие ветки сняты или лежат в .worktrees/" if not stray
            else "worktree не на месте: " + ", ".join(stray), warn=True)
    out.append(" ? лист приёмки эпика закрыт - проверь вручную: каждая находка помечена (исправлено / backlog / отложено)")
    print("\n".join(out))
    return 1 if bad else 0


# ---------- сторож Stop ----------

def guard_stop():
    """Хук Stop: один раз за сессию напомнить, что горячая память устарела.
    Не блокирует: сообщение уходит модели (additionalContext) и владельцу (systemMessage)."""
    if harness_off():
        return 0
    try:
        data = json.load(sys.stdin)
    except (ValueError, OSError):
        return 0
    if data.get("stop_hook_active") or data.get("agent_id"):
        return 0            # защита от петли и субагенты
    sid = str(data.get("session_id", "") or "")
    if not sid:
        return 0
    key = infer_project(data.get("cwd"))
    if not key:
        return 0
    code, plan, err = resolve(key)
    if err or not plan:
        return 0
    STATE.mkdir(parents=True, exist_ok=True)
    warned = STATE / f"stop-warned-{sid}"
    if warned.exists():
        return 0
    start_f = STATE / f"start-{sid}"
    try:
        start = start_f.stat().st_mtime
    except OSError:
        try:
            start = Path(data.get("transcript_path", "")).stat().st_ctime
        except OSError:
            return 0
    w = work_state(code, plan)
    if not w["mem_ts"] or w["last"] <= start:
        return 0            # за сессию ничего не менялось
    lag = w["last"] - w["mem_ts"]
    if lag <= STALE_MIN * 60:
        return 0
    warned.write_text(str(int(time.time())))
    msg = (f"Горячая память смены устарела: {tilde(w['mem'])} старше последней работы на {ago(lag)} "
           f"(коммитов после неё: {w['commits_code']} + {w['commits_plan']}, незакоммиченных: {w['dirty']}). "
           "Обнови next-session.md (первое дело следующей смены) и добавь строку в журнал, затем проверь `evm close`. "
           "Это одно напоминание за сессию; завершить работу оно не запрещает.")
    print(json.dumps({
        "hookSpecificOutput": {"hookEventName": "Stop", "additionalContext": msg},
        "systemMessage": f"evm: горячая память смены старше работы на {ago(lag)} - агента попросили обновить её",
    }, ensure_ascii=False))
    return 0


# ---------- постоянный выключатель харнесса ----------

HARNESS_FLAG = HOME / ".config/vosmenog/harness-off"     # есть файл - харнесс выключен


def harness_off():
    return HARNESS_FLAG.exists()


def source_dir():
    try:
        d = Path((HOME / ".config/opencode/.vosmenog-source").read_text().strip())
        return d if d.is_dir() else None
    except OSError:
        return None


def cmd_off():
    HARNESS_FLAG.parent.mkdir(parents=True, exist_ok=True)
    HARNESS_FLAG.write_text(time.strftime("%F %T") + "\n", encoding="utf-8")
    print("Харнесс ВЫКЛЮЧЕН (постоянно, пока не скажете evm on).\n"
          "  Перестало работать:\n"
          "   - хуки Claude Code (порядок чтения на старте и сторож памяти) молчат;\n"
          "   - evm boot печатает одну строку; проверка обновлений и автообновление молчат;\n"
          "   - update.sh и setup.sh не возвращают хуки, строку карты сервера и настройки (раньше удалённое возвращалось).\n"
          "  Осталось как есть:\n"
          "   - файлы метода на диске и обновление командой vosya-update (файлы обновятся, подключения - нет);\n"
          "   - строка @…/SERVER.md в ~/.claude/CLAUDE.md и строки instructions в opencode.json: это просто текст правил,\n"
          "     их можно убрать руками;\n"
          "   - команды evm close, evm threshold, evm status по явному вызову.\n"
          "  Включить обратно: evm on")
    return 0


def cmd_on():
    was = harness_off()
    try:
        HARNESS_FLAG.unlink()
    except OSError:
        pass
    print("Харнесс ВКЛЮЧЁН." if was else "Харнесс и так был включён.")
    src = source_dir()
    if not src:
        print("  Не нашёл клон репозитория (~/.config/opencode/.vosmenog-source): запустите vosya-update, он вернёт подключения.")
        return 0
    for rel in ("harness/connect-server-map.py", "harness/adapters/claude-code/install.py"):
        f = src / rel
        if f.is_file():
            r = subprocess.run([sys.executable, str(f)], capture_output=True, text=True)
            for ln in r.stdout.splitlines():
                print("  " + ln)
    print("  Хуки заработают со следующей сессии Claude Code.")
    return 0


def cmd_status():
    print(f"Харнесс: {'ВЫКЛЮЧЕН (evm on - включить)' if harness_off() else 'включён'}")
    print(f"Автообновление: {'включено' if auto_enabled() else 'выключено'} (evm auto on|off)")
    try:
        import json as _json
        conf = _json.loads((HOME / ".claude/settings.json").read_text(encoding="utf-8"))
        hooks = conf.get("hooks", {})
        has = lambda ev, needle: any(needle in str(h.get("command", "")) for e in hooks.get(ev, []) for h in e.get("hooks", []))
        print(f"Хуки Claude Code в settings.json: старт сессии {'есть' if has('SessionStart', 'session-start.sh') else 'нет'}, "
              f"сторож памяти {'есть' if has('Stop', 'stop-guard.sh') else 'нет'}"
              + ("; disableAllHooks=true - Claude Code их не запускает" if conf.get("disableAllHooks") else ""))
    except (OSError, ValueError):
        print("Хуки Claude Code: ~/.claude/settings.json не найден или не читается")
    src = source_dir()
    try:
        dep = (HOME / ".config/opencode/.vosmenog-deployed").read_text().strip()[:7]
    except OSError:
        dep = "?"
    print(f"Установленная версия: {dep}; клон: {src if src else 'не найден'}")
    return 0


# ---------- автообновление ----------

AUTO_CFG = HOME / ".config/vosmenog/auto-update"        # содержимое: on | off (нет файла = off)
AUTO_LAST = STATE / "auto-update.last"                  # метка времени последнего запуска
AUTO_RUN = STATE / "auto-update.running"                # pid фонового update.sh
AUTO_LOG = STATE / "auto-update.log"
AUTO_INTERVAL = int(os.environ.get("EVM_AUTO_INTERVAL_MIN", "360")) * 60
OC_CONF = HOME / ".config/opencode"
AUTO_MARK = "<!-- auto: ok -->"


def auto_enabled():
    try:
        return AUTO_CFG.read_text(encoding="utf-8").strip().lower() == "on"
    except OSError:
        return False


def auto_set(mode):
    AUTO_CFG.parent.mkdir(parents=True, exist_ok=True)
    AUTO_CFG.write_text(mode + "\n", encoding="utf-8")


def _entries(text):
    """Записи CHANGELOG.md: [(заголовок, помечена_ли_auto_ok)]. Метка - в пяти строках под заголовком."""
    lines = text.splitlines()
    out = []
    for i, ln in enumerate(lines):
        if ln.startswith("## "):
            out.append((ln.strip(), any(AUTO_MARK in x for x in lines[i + 1:i + 6])))
    return out


def _alive(pid):
    try:
        os.kill(pid, 0)
        return True
    except (ProcessLookupError, ValueError):
        return False
    except PermissionError:
        return True


def auto_run(source):
    """Решает, можно ли накатить обновление само, и если можно - запускает update.sh в фоне.
    Вызывается из update-check.sh, когда на GitHub есть то, чего нет на машине. Печатает одну-две строки
    для владельца. Условия (все): режим on; клон чистый и на main; обновление - fast-forward; каждая новая запись
    CHANGELOG.md помечена <!-- auto: ok --> (автор релиза утверждает: решений от пользователя не требуется);
    не чаще раза в 6 часов; фонового обновления сейчас нет."""
    if harness_off() or not auto_enabled():
        return 0
    src = Path(source) if source else None
    if not src:
        try:
            src = Path((OC_CONF / ".vosmenog-source").read_text().strip())
        except OSError:
            return 0
    if not (src / "update.sh").is_file():
        return 0

    def say(why):
        print(f"Автообновление включено, но эту версию нужно накатить вручную: {why}. Команда: vosya-update")
        return 0

    if git(src, "rev-parse", "--abbrev-ref", "HEAD").strip() != "main":
        return say("клон стоит не на ветке main")
    if git(src, "status", "--porcelain", "--untracked-files=no").strip():
        return say("в клоне есть незакоммиченные правки (они уехали бы на машину, но не в репозиторий)")
    if subprocess.run(["git", "-C", str(src), "merge-base", "--is-ancestor", "HEAD", "origin/main"]).returncode != 0:
        return say("обновление не сводится простым «вперёд» (в клоне свои коммиты)")
    new_text = git(src, "show", "origin/main:CHANGELOG.md")
    try:
        dep = (OC_CONF / ".vosmenog-deployed").read_text().strip()
    except OSError:
        dep = ""
    old_text = git(src, "show", f"{dep}:CHANGELOG.md") if dep else ""
    old = {h for h, _ in _entries(old_text)}
    fresh = [(h, ok) for h, ok in _entries(new_text) if h not in old]
    if not fresh:
        return say("в обновлении нет новой записи в CHANGELOG.md (по правилу такие накатывает владелец)")
    manual = [h for h, ok in fresh if not ok]
    if manual:
        return say("автор релиза не пометил как безопасное: " + "; ".join(h[3:60] for h in manual))
    STATE.mkdir(parents=True, exist_ok=True)
    try:
        if _alive(int(AUTO_RUN.read_text().strip())):
            return 0                                    # уже идёт
    except (OSError, ValueError):
        pass
    try:
        if time.time() - AUTO_LAST.stat().st_mtime < AUTO_INTERVAL:
            return 0                                    # недавно пробовали
    except OSError:
        pass
    log = open(AUTO_LOG, "a", encoding="utf-8")
    log.write(f"\n=== {time.strftime('%F %T')} автообновление: {len(fresh)} новых записей CHANGELOG, все помечены auto: ok ===\n")
    log.flush()
    proc = subprocess.Popen(["bash", str(src / "update.sh"), "--auto"], cwd=str(src), stdin=subprocess.DEVNULL,
                            stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    AUTO_RUN.write_text(str(proc.pid))
    AUTO_LAST.write_text(str(int(time.time())))
    print(f"Автообновление: накатываю в фоне ({len(fresh)} новых записей CHANGELOG, все помечены безопасными). "
          f"Журнал: {AUTO_LOG}. Новые инструкции и хуки заработают со следующей сессии; что именно изменилось - увидите там как «Метод обновился».")
    return 0


def auto_status():
    print(f"Автообновление: {'ВКЛЮЧЕНО' if auto_enabled() else 'выключено'}  (файл {AUTO_CFG})")
    try:
        t = AUTO_LAST.stat().st_mtime
        print(f"Последний запуск: {time.strftime('%F %T', time.localtime(t))}; журнал {AUTO_LOG}")
    except OSError:
        print("Запусков не было.")
    try:
        pid = int(AUTO_RUN.read_text().strip())
        print(f"Фоновое обновление: {'идёт, pid ' + str(pid) if _alive(pid) else 'не идёт'}")
    except (OSError, ValueError):
        pass
    print("Накатывается само только то, что автор релиза пометил в CHANGELOG.md строкой " + AUTO_MARK + ";\n"
          "остальное - вручную: vosya-update. Выключить: evm auto off.")
    return 0


# ---------- main ----------

def main():
    ap = argparse.ArgumentParser(prog="evm", description=__doc__.splitlines()[0],
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = ap.add_subparsers(dest="cmd")
    b = sub.add_parser("boot", help="что читать и что сейчас горит")
    b.add_argument("project", nargs="?")
    b.add_argument("--role", choices=ROLES, default=os.environ.get("EVM_ROLE") if os.environ.get("EVM_ROLE") in ROLES else "solo")
    b.add_argument("--brief", action="store_true")
    sub.add_parser("threshold", help="порог смены")
    c = sub.add_parser("close", help="чек-лист закрытия смены")
    c.add_argument("project", nargs="?")
    g = sub.add_parser("guard", help="сторожа для хуков")
    g.add_argument("what", choices=["stop"])
    sub.add_parser("off", help="выключить харнесс постоянно")
    sub.add_parser("on", help="включить харнесс обратно")
    sub.add_parser("status", help="состояние харнесса, автообновления, хуков")
    au = sub.add_parser("auto", help="автоматическое обновление метода: on | off | status")
    au.add_argument("action", choices=["on", "off", "status", "run"])
    au.add_argument("--source")
    a = ap.parse_args()
    if a.cmd == "boot":
        return boot(a.project, a.role, a.brief)
    if a.cmd == "threshold":
        print("\n".join(threshold_lines(None)))
        return 0
    if a.cmd == "close":
        return close(a.project)
    if a.cmd == "guard":
        return guard_stop()
    if a.cmd == "off":
        return cmd_off()
    if a.cmd == "on":
        return cmd_on()
    if a.cmd == "status":
        return cmd_status()
    if a.cmd == "auto":
        if a.action in ("on", "off"):
            auto_set(a.action)
            print("Автообновление " + ("ВКЛЮЧЕНО: свежий релиз, который автор пометил безопасным, накатится в фоне на старте сессии."
                                      if a.action == "on" else "выключено: обновления ставятся только вручную (vosya-update)."))
            return 0
        if a.action == "status":
            return auto_status()
        return auto_run(a.source)
    ap.print_help()
    return 0


if __name__ == "__main__":
    sys.exit(main())
